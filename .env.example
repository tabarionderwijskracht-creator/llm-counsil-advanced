# LLM Council - API Keys
# Copy this file to .env and fill in your keys

# You can use provider-specific keys (OPENAI_API_KEY, ANTHROPIC_API_KEY,
# GOOGLE_API_KEY) or a single OpenRouter key below.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-v1-...
